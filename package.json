{
  "name": "siji-todo",
  "version": "1.0.1",
  "description": "四季待办 — 离线桌面任务管理",
  "main": "src/main.cjs",
  "author": "Codex_workspace",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis portable",
    "test:ui": "node scripts/smoke-ui.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "com.pigrey.siji.todo",
    "productName": "四季待办",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
